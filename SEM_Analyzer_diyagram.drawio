        <mxCell id="r0" value="&lt;b&gt;Seçili fotoğraf(lar)ın parçacıkları&lt;/b&gt;&lt;br&gt;&lt;i&gt;Birden fazla fotoğraf seçiliyse parçacıklar tek havuzda birleştirilir (Aggregate)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
