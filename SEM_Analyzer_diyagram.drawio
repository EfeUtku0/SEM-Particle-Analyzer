        <mxCell id="k10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="r9" target="r11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5n1" value="&lt;b&gt;D-DEĞERLERİ: SAYI-AĞIRLIKLI&lt;/b&gt; &lt;span style=&quot;color:#b85450&quot;&gt;(makale için kritik)&lt;/span&gt;&lt;br&gt;&lt;br&gt;Buradaki D50 = &quot;parçacıkların yarısı bu çapın altında&quot; — her parçacık &lt;b&gt;bir&lt;/b&gt; sayılır.&lt;br&gt;&lt;br&gt;Zetasizer / lazer difraksiyon varsayılan olarak &lt;b&gt;HACİM-ağırlıklı&lt;/b&gt; verir (her parçacık d³ sayılır).&lt;br&gt;&lt;br&gt;Sizin verinizde ölçüldü: &lt;b&gt;Dn50 = 259 nm&lt;/b&gt; ↔ &lt;b&gt;Dv50 = 1216 nm&lt;/b&gt; → &lt;b&gt;4,7 kat fark&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Görüntü analizi ancak sayı-ağırlıklı verebilir; bu doğru ve savunulabilir.&lt;br&gt;Sadece makalede &lt;b&gt;&quot;number-based&quot;&lt;/b&gt; olduğu açıkça yazılmalı ve Zetasizer&lt;br&gt;değerleriyle yan yana konmamalı.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="900" width="920" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p5n2" value="&lt;b&gt;Havuzlama uyarısı&lt;/b&gt;&lt;br&gt;Birden fazla fotoğraf seçilince parçacıklar&lt;br&gt;&lt;b&gt;tek havuza&lt;/b&gt; atılır — yani çok parçacıklı bir&lt;br&gt;fotoğraf sonucu domine eder.&lt;br&gt;&lt;br&gt;Örnek: UÖ-05 Alt&#39;ta fotoğraflar&lt;br&gt;169 / 538 / 2990 parçacık veriyor.&lt;br&gt;&lt;br&gt;&lt;i&gt;Makalede &quot;n=3 görüntü, ortalama ± SD&quot; isteniyorsa&lt;br&gt;fotoğraf başına ayrı ortalama almak gerekir.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1420" y="760" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p5n3" value="&lt;b&gt;Büyütme etkisi (ölçüldü)&lt;/b&gt;&lt;br&gt;Aynı numunenin farklı büyütmedeki&lt;br&gt;fotoğrafları &lt;b&gt;2 kata kadar&lt;/b&gt; farklı&lt;br&gt;ortalama veriyor (319 → 619 nm).&lt;br&gt;&lt;br&gt;Sebep tespit tabanı değil; yüksek&lt;br&gt;büyütmede büyük parçacıkların&lt;br&gt;kadraja sığmaması + alan seçimi.&lt;br&gt;&lt;br&gt;&lt;i&gt;→ Karşılaştırılacak numuneler&lt;br&gt;&lt;b&gt;aynı büyütmede&lt;/b&gt; çekilmeli.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="330" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page6" name="6 · Eğitim Döngüsü + Depolama">
    <mxGraphModel dx="1147" dy="631" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p6t" parent="1" style="text;html=1;align=center;fontSize=22;" value="&lt;b&gt;EĞİTİM DÖNGÜSÜ ve VERİ DEPOLAMA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Modeli siz eğitiyorsunuz; hangi analizin hangi model sürümüyle yapıldığı takip ediliyor&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="900" x="450" y="20" as="geometry" />
        </mxCell>
        <mxCell id="t1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" value="&lt;b&gt;1. Training moduna geç&lt;/b&gt;&lt;br&gt;Bir fotoğrafta parçacıklara tıklayarak&lt;br&gt;&lt;b&gt;doğru sınıfı&lt;/b&gt; öğret&lt;br&gt;(1–6 tuşları · 0 = &quot;bu güvenilmez&quot;)" vertex="1">
          <mxGeometry height="100" width="320" x="120" y="150" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" value="&lt;b&gt;2. &quot;Add to training set&quot;&lt;/b&gt;&lt;br&gt;Fotoğraf onaylanır ve masaüstündeki&lt;br&gt;&lt;b&gt;SEM Eğitim&lt;/b&gt; klasörüne yazılır" vertex="1">
          <mxGeometry height="90" width="320" x="120" y="300" as="geometry" />
        </mxCell>
        <mxCell id="t3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;~/Desktop/SEM Eğitim/&lt;/b&gt; &lt;i&gt;(görünür klasör)&lt;/i&gt;&lt;br&gt;&lt;br&gt;Her onaylı fotoğraf için:&lt;br&gt;• &lt;b&gt;.jpeg&lt;/b&gt; — orijinalin kopyası&lt;br&gt;• &lt;b&gt;(etiketli).png&lt;/b&gt; — onayladığınız görüntü&lt;br&gt;• &lt;b&gt;.labels.json&lt;/b&gt; — parçacık başına sınıf + konum + çap&lt;br&gt;• &lt;b&gt;.crops.npz&lt;/b&gt; — eğitime hazır 128px kırpımlar&lt;br&gt;• &lt;b&gt;.vis.npz&lt;/b&gt; — görünürlük etiketleri (henüz kullanılmıyor)&lt;br&gt;&lt;br&gt;&lt;i&gt;Şu an: &lt;b&gt;32 fotoğraf / 15.803 etiket&lt;/b&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="200" width="440" x="120" y="440" as="geometry" />
        </mxCell>
        <mxCell id="t4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;3. &quot;Train model&quot;&lt;/b&gt; — pattern_train.py&lt;br&gt;&lt;br&gt;• Tüm .crops.npz dosyaları birleştirilir&lt;br&gt;• &lt;b&gt;Fotoğraf-gruplu 3-kat çapraz doğrulama&lt;/b&gt;&lt;br&gt;&lt;i&gt;(aynı fotoğrafın parçacıkları hem eğitimde hem&lt;br&gt;testte olamaz — dürüst skor için şart)&lt;/i&gt;&lt;br&gt;• Sonra tüm veriyle nihai model eğitilir&lt;br&gt;• resnet18, 128px, veri artırma (döndürme/parlaklık)" vertex="1">
          <mxGeometry height="200" width="460" x="660" y="440" as="geometry" />
        </mxCell>
        <mxCell id="t5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;4. Yeni patternnet.pt&lt;/b&gt;&lt;br&gt;Uygulama veri klasörüne yazılır&lt;br&gt;&lt;i&gt;(eski model zaman damgalı yedek olarak saklanır)&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="340" x="1240" y="470" as="geometry" />
        </mxCell>
        <mxCell id="t6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="&lt;b&gt;5. Pipeline damgası değişir&lt;/b&gt;&lt;br&gt;&lt;i&gt;(model dosyasının kimliği damgaya giriyor)&lt;/i&gt;&lt;br&gt;&lt;br&gt;→ sol paneldeki &lt;b&gt;bütün noktalar amber olur&lt;/b&gt;&lt;br&gt;= &quot;bu analizler eski modelle yapıldı&quot;" vertex="1">
          <mxGeometry height="110" width="340" x="1240" y="610" as="geometry" />
        </mxCell>
        <mxCell id="t7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="&lt;b&gt;6. Yeniden Analyze&lt;/b&gt;&lt;br&gt;Maskeler önbellekte olduğu için ~10 s/fotoğraf&lt;br&gt;→ nokta &lt;b&gt;yeşile&lt;/b&gt; döner" vertex="1">
          <mxGeometry height="80" width="340" x="1240" y="770" as="geometry" />
        </mxCell>
        <mxCell id="q1" edge="1" parent="1" source="t1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" target="t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q2" edge="1" parent="1" source="t2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" target="t3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q3" edge="1" parent="1" source="t3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" target="t4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q4" edge="1" parent="1" source="t4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" target="t5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q5" edge="1" parent="1" source="t5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" target="t6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q6" edge="1" parent="1" source="t6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" target="t7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;solidnet EĞİTİLMİYOR&lt;/b&gt;&lt;br&gt;&quot;Train model&quot; sadece &lt;b&gt;patternnet&lt;/b&gt;&#39;i eğitir.&lt;br&gt;Katı/undercooled ayrımını yapan solidnet&lt;br&gt;uygulamayla gelen sabit modeldir.&lt;br&gt;&lt;br&gt;&lt;i&gt;Yeniden eğitmek denendi ve reddedildi:&lt;br&gt;yüksek duyarlılık bölgesinde mevcut modeli&lt;br&gt;geçemiyor (ölçülmüş sonuç).&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="460" x="660" y="690" as="geometry" />
        </mxCell>
        <mxCell id="t9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;undercooled etiketleri patternnet&#39;e gitmez&lt;/b&gt;&lt;br&gt;Ağ yalnızca 4 desen sınıfını öğrenir; undercooled&lt;br&gt;etiketleri .labels.json&#39;da kayıt olarak kalır.&lt;br&gt;&lt;br&gt;&lt;i&gt;Zayıf sınıf: composite (en az örnek).&lt;br&gt;Gerçek kazanç = daha çok composite örneği.&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="440" x="120" y="690" as="geometry" />
        </mxCell>
        <mxCell id="st0" parent="1" style="text;html=1;align=center;fontSize=18;fontStyle=1" value="&lt;b&gt;KALICI DOSYALAR&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="400" x="700" y="900" as="geometry" />
        </mxCell>
        <mxCell id="st1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;session.pkl&lt;/b&gt; &lt;i&gt;(~200 MB)&lt;/i&gt;&lt;br&gt;Tüm analizler (maskeler + piksel verisi dahil)&lt;br&gt;+ sınıf düzeltmeleriniz + ölçüm müdahaleleriniz&lt;br&gt;&lt;br&gt;&lt;i&gt;Her kayıtta bir öncekisi .bak olarak saklanır&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="120" y="960" as="geometry" />
        </mxCell>
        <mxCell id="st2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;library.json&lt;/b&gt;&lt;br&gt;Sol paneldeki sanal klasör ağacı&lt;br&gt;&lt;i&gt;(diskteki dosyalar asla taşınmaz)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3 katmanlı yedek:&lt;/b&gt; .bak (bir önceki) ·&lt;br&gt;.startup.json (oturum açılışı) ·&lt;br&gt;.shrink.json (görüntü sayısı düştüğü an)" vertex="1">
          <mxGeometry height="140" width="400" x="560" y="960" as="geometry" />
        </mxCell>
        <mxCell id="st3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;mask_cache/&lt;/b&gt;&lt;br&gt;Cellpose maskeleri (.npz) + kalibrasyon (.scale.json)&lt;br&gt;&lt;i&gt;Dosya yolu + değişim tarihi + boyutla anahtarlanır&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Yeniden analizi 50 s → 10 s yapan şey budur.&lt;/b&gt;&lt;br&gt;&lt;i&gt;Silinirse veri kaybolmaz, sadece yavaşlar.&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="400" x="1000" y="960" as="geometry" />
        </mxCell>
        <mxCell id="st4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;patternnet.pt&lt;/b&gt;&lt;br&gt;Eğittiğiniz model + zaman damgalı yedekleri&lt;br&gt;&lt;i&gt;Uygulama veri klasöründe&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="300" x="1440" y="960" as="geometry" />
        </mxCell>
        <mxCell id="st5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;En sağlam veriniz hangisi?&lt;/b&gt;&lt;br&gt;&lt;b&gt;~/Desktop/SEM Eğitim&lt;/b&gt; klasörü — session.pkl&#39;den tamamen bağımsız,&lt;br&gt;düz dosyalar hâlinde, elle yedeklenebilir. Uygulama silinse bile eğitim veriniz durur.&lt;br&gt;&lt;i&gt;session.pkl bozulursa analizleri yeniden çalıştırmak gerekir ama etiketleriniz kaybolmaz.&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="1000" x="400" y="1140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
