          <mxGeometry x="740" y="230" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;CLASSIFIED&lt;/b&gt;&lt;br&gt;ölçülenlerden bir sınıfa girenler&lt;br&gt;= undercooled + 4 desen&lt;br&gt;&lt;i&gt;yanındaki % = MEASURED&#39;a oranı&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="230" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;MEASURED − CLASSIFIED&lt;/b&gt; farkı ne?&lt;br&gt;• desensiz katılar (ağ deseni okuyamadı)&lt;br&gt;• &quot;sınıfı belirsiz&quot; işaretledikleriniz&lt;br&gt;&lt;i&gt;Ölçülüyorlar ama hiçbir sınıf yüzdesine girmiyorlar.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="330" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="&lt;b&gt;SINIF KUTUCUKLARI&lt;/b&gt; — hepsi MEASURED üzerinden hesaplanır&lt;br&gt;&lt;br&gt;&lt;b&gt;UNDERCOOLED&lt;/b&gt; = ölçülen, katı olmayan&lt;br&gt;&lt;b&gt;SOLID&lt;/b&gt; = MEASURED − undercooled − &quot;belirsiz&quot;&lt;br&gt;&lt;b&gt;JANUS / STRIPE / LAMELLAR / COMPOSITE&lt;/b&gt; = kendi desenleri&lt;br&gt;&lt;br&gt;&lt;i&gt;SOLID bir ÜST kategoridir: 4 deseni de kapsar.&lt;br&gt;Bu yüzden satır toplamı &lt;b&gt;%100&#39;ü geçer&lt;/b&gt; — kasıtlı.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="380" width="560" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="&lt;b&gt;Değişmez kural (kod garantisi)&lt;/b&gt;&lt;br&gt;undercooled + solid + belirsiz = &lt;b&gt;MEASURED&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Ekrandaki kutucuklar ve export edilen figür&lt;br&gt;&lt;b&gt;aynı fonksiyondan&lt;/b&gt; besleniyor (report.class_counts),&lt;br&gt;bu yüzden birbirinden ayrılamazlar.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="390" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="&lt;b&gt;MEAN SIZE&lt;/b&gt;&lt;br&gt;ölçülenlerin&lt;br&gt;aritmetik ortalaması" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="600" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r8" value="&lt;b&gt;HİSTOGRAM&lt;/b&gt;&lt;br&gt;ölçülenlerin boyut dağılımı&lt;br&gt;&lt;i&gt;yuvarlak aralıklara bölünür&lt;br&gt;(5/10/20/50/100... nm)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="600" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r9" value="&lt;b&gt;CUMULATIVE&lt;/b&gt;&lt;br&gt;D10 / D50 / D90 / SPAN&lt;br&gt;&lt;i&gt;SPAN = (D90−D10) / D50&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="600" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r10" value="&lt;b&gt;PATTERN × SIZE&lt;/b&gt;&lt;br&gt;her boyut aralığının&lt;br&gt;sınıf kompozisyonu&lt;br&gt;&lt;i&gt;(%100 yığılmış şerit)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1100" y="600" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r11" value="&lt;b&gt;PNG EXPORT&lt;/b&gt;&lt;br&gt;seçilen grafikler + sayı kutucukları&lt;br&gt;+ isteğe bağlı SEM görselleri&lt;br&gt;&lt;i&gt;(ölçüm çizgili / sınıf renkli / desen renkli)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="760" width="560" height="80" as="geometry" />
        </mxCell>
