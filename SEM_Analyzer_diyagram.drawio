        <mxCell id="ec2" edge="1" parent="1" source="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;startArrow=none;" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;DİKKAT — sayıyı etkileyen taban&lt;/b&gt;&lt;br&gt;Sayıma girmek için: çap ≥ 15 nm &lt;b&gt;VE&lt;/b&gt; ≥ 4 px&lt;br&gt;&lt;b&gt;VE&lt;/b&gt; alan ≥ 30 px (Cellpose parçacıkları).&lt;br&gt;Kaba fotoğrafta (26,9 nm/px) bu taban&lt;br&gt;fiilen &lt;b&gt;166 nm&lt;/b&gt;, ince fotoğrafta (1,8 nm/px)&lt;br&gt;&lt;b&gt;11 nm&lt;/b&gt;. Yani tespit sınırı büyütmeye bağlı." vertex="1">
          <mxGeometry height="105" width="290" x="1080" y="490" as="geometry" />
        </mxCell>
        <mxCell id="en1" edge="1" parent="1" source="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;" target="n1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Sadece CBS&#39;te sınıflandırma var&lt;/b&gt;&lt;br&gt;ETD görüntüsünde iç doku görünmediği için&lt;br&gt;katı/undercooled ayrımı yapılmaz (&quot;N/A&quot;).&lt;br&gt;Boyut ölçümü yine de çalışır." vertex="1">
          <mxGeometry height="75" width="290" x="1080" y="620" as="geometry" />
        </mxCell>
        <mxCell id="en2" edge="1" parent="1" source="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Küçük parçacıklar ağa HİÇ girmez&lt;/b&gt;&lt;br&gt;Top-hat ile kurtarılan küçükler solidnet ve&lt;br&gt;patternnet&#39;e verilmez → otomatik olarak&lt;br&gt;undercooled sayılırlar (200 nm kuralı zaten&lt;br&gt;aynı sonucu verirdi, 250 nm&#39;ye kadar)." vertex="1">
          <mxGeometry height="90" width="280" x="220" y="615" as="geometry" />
        </mxCell>
        <mxCell id="en3" edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;" target="a5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;En önemli ayrım&lt;/b&gt;&lt;br&gt;&lt;b&gt;SINIF&lt;/b&gt; ve &lt;b&gt;ÖLÇÜM&lt;/b&gt; iki ayrı karardır.&lt;br&gt;Bir parçacık &quot;lamellar&quot; olup ölçülmeyebilir&lt;br&gt;(deseni görünüyor ama çapı güvenilmez).&lt;br&gt;Tersi de olur.&lt;br&gt;&lt;i&gt;Bu, kasıtlı bir tasarım kararınız.&lt;/i&gt;" vertex="1">
          <mxGeometry height="105" width="280" x="220" y="800" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Kalıcı depolama&lt;/b&gt;&lt;br&gt;session.pkl → tüm analizler + düzeltmeler&lt;br&gt;library.json → sol paneldeki klasör ağacı&lt;br&gt;&lt;i&gt;Sayfa 6&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="290" x="1080" y="1015" as="geometry" />
        </mxCell>
        <mxCell id="es1" edge="1" parent="1" source="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Eğitim döngüsü&lt;/b&gt;&lt;br&gt;Training modunda etiketlediğiniz parçacıklar&lt;br&gt;→ patternnet yeniden eğitilir → 5. adım değişir&lt;br&gt;&lt;i&gt;Sayfa 6&lt;/i&gt;" vertex="1">
          <mxGeometry height="75" width="280" x="220" y="450" as="geometry" />
        </mxCell>
        <mxCell id="etr1" edge="1" parent="1" source="tr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" target="a5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
