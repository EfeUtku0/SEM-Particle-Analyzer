      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5t" value="&lt;b&gt;SAYILAR NEREDEN GELİYOR?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;RESULTS panelindeki her kutucuğun ve her grafiğin tanımı&lt;/span&gt;" style="text;html=1;align=center;fontSize=22;" vertex="1" parent="1">
