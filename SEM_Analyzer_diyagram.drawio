          <mxGeometry height="45" width="560" x="560" y="285" as="geometry" />
        </mxCell>
        <mxCell id="m3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="&lt;b&gt;3) Kadraja fazla mı taşıyor?&lt;/b&gt;&lt;br&gt;edge_cut &amp;gt; &lt;b&gt;0,60&lt;/b&gt; → &lt;b&gt;ÖLÇME&lt;/b&gt;&lt;br&gt;&lt;i&gt;0,60&#39;ta çap hatası ~%2,6; 0,90&#39;da ~%11 olurdu&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="560" x="560" y="355" as="geometry" />
