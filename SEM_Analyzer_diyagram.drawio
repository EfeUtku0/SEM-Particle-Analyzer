        <mxCell id="u0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontStyle=1" value="&lt;b&gt;KULLANICI DÜZELTME KATMANI&lt;/b&gt; — _view_analysis()&lt;br&gt;&lt;i&gt;Ham analiz ASLA değişmez. Düzeltmeler her çizimde üstüne bindirilir.&lt;br&gt;Bu yüzden hiçbir düzeltme eğitim verisini kirletmez.&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="720" x="480" y="920" as="geometry" />
        </mxCell>
        <mxCell id="u1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;1–6 tuşları / tıklama&lt;/b&gt;&lt;br&gt;&lt;b&gt;Sınıf ata&lt;/b&gt; (class_overrides)&lt;br&gt;&lt;br&gt;İkinci tık → sınıfı geri al&lt;br&gt;(&quot;ne olduğu belirsiz&quot; durumu)&lt;br&gt;Üçüncü tık → modele geri ver&lt;br&gt;&lt;br&gt;&lt;b&gt;Ölçüm durumunu DEĞİŞTİRMEZ&lt;/b&gt;" vertex="1">
          <mxGeometry height="160" width="300" x="220" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="u2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;Measure aracı (M)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Sol tık&lt;/b&gt; → ölçüme &lt;b&gt;zorla sok&lt;/b&gt;&lt;br&gt;&lt;b&gt;Sağ tık&lt;/b&gt; → ölçümden &lt;b&gt;çıkar&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Ölçüme müdahalenin&lt;br&gt;TEK yolu budur&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#b85450&quot;&gt;&lt;b&gt;Yeniden Analyze bunları SİLER&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="300" x="560" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="u3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;0 tuşu&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tamamen ele&lt;/b&gt; (view_excluded)&lt;br&gt;&lt;br&gt;Parçacık silinmez; modelin&lt;br&gt;kendi elediklerİ gibi işaretlenir:&lt;br&gt;sınıfsız + ölçümsüz + mavi&lt;br&gt;&lt;br&gt;&lt;i&gt;Yeniden analizde korunur&lt;/i&gt;" vertex="1">
          <mxGeometry height="160" width="300" x="900" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="u4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;⌘Z&lt;/b&gt;&lt;br&gt;Çoklu geri alma&lt;br&gt;(son 100 adım)&lt;br&gt;&lt;br&gt;Her düzeltmeden önce&lt;br&gt;durumun anlık görüntüsü&lt;br&gt;alınır" vertex="1">
          <mxGeometry height="160" width="260" x="1240" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="uh1" edge="1" parent="1" source="u0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" target="u1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uh2" edge="1" parent="1" source="u0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" target="u2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uh3" edge="1" parent="1" source="u0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" target="u3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uh4" edge="1" parent="1" source="u0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" target="u4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4n1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;Yeniden Analyze edince ne olur?&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;KORUNUR:&lt;/b&gt; sınıf atamalarınız (1–6), tamamen eledikleriniz (0)&lt;br&gt;&lt;b&gt;SİLİNİR:&lt;/b&gt; Measure aracıyla yaptığınız sol/sağ tıklar&lt;br&gt;&lt;br&gt;&lt;i&gt;Gerekçe: &quot;yeniden analiz&quot; = &quot;bu fotoğrafa yeni kurallarla baştan karar ver&quot;.&lt;br&gt;Ölçüm kapısı da baştan çalışsın diye eski elle müdahaleler temizlenir.&lt;br&gt;&lt;b&gt;Bu yüzden ölçülen parçacık sayısı yeniden analiz sonrası ARTABİLİR.&lt;/b&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="720" x="480" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="p4n2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Kalan yanlılık (ölçüldü, kabul edildi)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Kadraj kesme:&lt;/b&gt; büyük parçacık daha sık kesilir → elenirler.&lt;br&gt;Tarafsız kestirimle ortalama medyan &lt;b&gt;+%2,35&lt;/b&gt; daha yüksek çıkıyor&lt;br&gt;(en kötü fotoğrafta +%6,6).&lt;br&gt;&lt;br&gt;&lt;b&gt;Sınıfa bağlı eleme:&lt;/b&gt; desenli ve undercooled parçacıklar kapıyı&lt;br&gt;%98–99 geçiyor, desensiz katılar sadece %41.&lt;br&gt;→ ölçülen küme katı aleyhine seçilmiş oluyor." vertex="1">
          <mxGeometry height="180" width="380" x="1180" y="330" as="geometry" />
        </mxCell>
        <mxCell id="p4n3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Neden 0,90?&lt;/b&gt;&lt;br&gt;14 fotoğraf / 7.306 parçacıkta ölçüldü:&lt;br&gt;0,85 → %86,5 ölçülür&lt;br&gt;0,88 → %83,5&lt;br&gt;&lt;b&gt;0,90 → %80,0&lt;/b&gt; ← seçilen&lt;br&gt;0,92 → %75,3 &lt;i&gt;(burada ilk kez desenli&lt;br&gt;parçacıklar da düşmeye başlıyor)&lt;/i&gt;" vertex="1">
          <mxGeometry height="130" width="380" x="1180" y="620" as="geometry" />
        </mxCell>
        <mxCell id="p4n4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Sınıf ve ölçüm neden ayrı?&lt;/b&gt;&lt;br&gt;Bir parçacığın deseni belli olabilir ama&lt;br&gt;çapı güvenilmez olabilir (arkada duruyor).&lt;br&gt;Tersi de mümkün.&lt;br&gt;&lt;br&gt;Bu yüzden &quot;lamellar&quot; demek onu&lt;br&gt;ölçüme &lt;b&gt;sokmaz&lt;/b&gt;; ölçümden çıkarmak da&lt;br&gt;sınıfını &lt;b&gt;bozmaz&lt;/b&gt;." vertex="1">
          <mxGeometry height="150" width="330" x="180" y="330" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
