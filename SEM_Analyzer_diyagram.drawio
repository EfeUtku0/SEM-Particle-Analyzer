        <mxCell id="p2n1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Hız notu (ölçüldü)&lt;/b&gt;&lt;br&gt;Cellpose: ~50 s &lt;i&gt;(toplamın %85&#39;i)&lt;/i&gt;&lt;br&gt;OCR: 4,1 s · patternnet: 2,7 s&lt;br&gt;solidnet: 0,6 s&lt;br&gt;&lt;br&gt;&lt;b&gt;Önbellekli yeniden analiz: ~10 s&lt;/b&gt;&lt;br&gt;(3 ve 1 numaralı adımlar atlanır)" vertex="1">
          <mxGeometry height="130" width="250" x="1120" y="365" as="geometry" />
        </mxCell>
        <mxCell id="p2n2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Neden eşdeğer daire çapı?&lt;/b&gt;&lt;br&gt;Alandan türetilir, tek bir yöne bağlı&lt;br&gt;değildir. Feret çapı bilerek&lt;br&gt;reddedildi (kullanıcı kararı).&lt;br&gt;&lt;br&gt;&lt;b&gt;Doğrulandı:&lt;/b&gt; diam_px / √(major·minor)&lt;br&gt;medyanı 0,997 → maskeler tutarlı." vertex="1">
          <mxGeometry height="130" width="250" x="1120" y="650" as="geometry" />
        </mxCell>
        <mxCell id="p2n3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;dashed=1;" value="&lt;b&gt;Kalibrasyon doğruluğu (ölçüldü)&lt;/b&gt;&lt;br&gt;Bar uç çizgileri 3 px kalın; kod dış&lt;br&gt;kenardan ölçüyor. Uç-merkezinden&lt;br&gt;ölçülse %0,4 fark ederdi.&lt;br&gt;Farklı etiket/bar kombinasyonları&lt;br&gt;aynı büyütme merdivenine %0,2–0,45&lt;br&gt;içinde düşüyor → &lt;b&gt;kalibrasyon sağlam&lt;/b&gt;." vertex="1">
          <mxGeometry height="140" width="250" x="1120" y="110" as="geometry" />
        </mxCell>
        <mxCell id="p2n4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Buradaki asimetri&lt;/b&gt;&lt;br&gt;Cellpose parçacıkları için alan tabanı&lt;br&gt;&lt;b&gt;30 px&lt;/b&gt; (≈ 6,2 px çap), kurtarılmış&lt;br&gt;küçükler için &lt;b&gt;12,6 px&lt;/b&gt; (4 px çap).&lt;br&gt;İki farklı taban = iki farklı tespit sınırı." vertex="1">
          <mxGeometry height="100" width="270" x="130" y="640" as="geometry" />
        </mxCell>
      </root>
